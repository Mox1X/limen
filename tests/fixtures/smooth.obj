# Eight-triangle octahedron, smooth radial normals, two OBJ objects.
# A material library is deliberately absent: the viewer ignores materials.
mtllib absent.mtl
v 0 1 0
v 1 0 0
v 0 0 1
v -1 0 0
v 0 0 -1
v 0 -1 0
vn 0 1 0
vn 1 0 0
vn 0 0 1
vn -1 0 0
vn 0 0 -1
vn 0 -1 0
o top
f 1//1 3//3 2//2
f 1//1 4//4 3//3
f 1//1 5//5 4//4
f 1//1 2//2 5//5
o bottom
f 6//6 2//2 3//3
f 6//6 3//3 4//4
f 6//6 4//4 5//5
f 6//6 5//5 2//2
